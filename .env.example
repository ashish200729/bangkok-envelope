# Copy to apps/web/.env.local. Never commit real values.

# Neon pooled connection string (Project → Connect → Pooled connection).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Public origin of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3100"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
