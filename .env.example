# Copy to apps/web/.env.local for local development. Never commit real values.
# On Vercel, set only the two required variables in Project → Settings → Environment Variables.

# Required. Neon pooled connection string (Project → Connect → Pooled connection).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Required. 32+ random characters: `openssl rand -base64 32`. Use a different one per environment.
BETTER_AUTH_SECRET=""

# Optional. The app's public origin, no trailing slash. Leave unset on Vercel: it is taken from
# VERCEL_PROJECT_PRODUCTION_URL in production and the branch URL on previews. Locally it defaults
# to http://localhost:3100; set it only for a custom domain or another local port.
# BETTER_AUTH_URL="http://localhost:3100"
